# ============================================================
# CRM Lure — variaveis de ambiente (Doc 09, secao 5.2)
#
# Copie para .env.local e preencha. O .env.local NAO vai para o git.
#
# ⚠️ Sem BOM. A regra 7 do Doc 00 pede UTF-8 com BOM, mas ela vale para
# documentos e CSVs. Arquivo .env com BOM quebra o CLI do Supabase:
# "unexpected character in variable name". Testado.
#
# ⚠️ Nenhum segredo em variavel NEXT_PUBLIC_. Tudo que leva esse prefixo
# e embutido no pacote que vai para o navegador e fica visivel a qualquer
# um que abra o inspetor. Token do Bubble e chave de servico ficam so no
# servidor — foi a razao decisiva pelo Next.js sobre o Vite (D-080).
# ============================================================

# ---------- Supabase ----------
# Painel do projeto > Project Settings > API.
# Os valores abaixo sao os do banco local (`npx supabase start`), que e
# onde a construcao acontece. Ha UMA base na nuvem (D-101): ao apontar
# para ela, este arquivo passa a conter credenciais de PRODUCAO.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Ignora RLS por completo — nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Dominio da empresa ----------
# Autorizacao por dominio (D-050). Precisa bater com a funcao
# public.dominio_empresa() do banco, definida em
# supabase/migrations/20260813120200_acesso_e_usuarios.sql
DOMINIO_EMPRESA=lureconsultoria.com.br

# ---------- Bubble ----------
# Seletor de cliente no dialogo de Ganho (D-076, D-077). Somente servidor:
# a rota /api/bubble/clientes faz o GET e devolve a lista ja filtrada.
# Pendencia P-022 — depende de habilitar a Data API no sistema Bubble.
BUBBLE_API_URL=
BUBBLE_API_TOKEN=
